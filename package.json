{
  "name": "mmd-gltf",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "tsx tools/fetch-gene.ts",
    "convert": "tsx tools/pmx-to-gltf.ts",
    "example:assets": "tsx tools/prepare-example.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run example:assets && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node extensions/MMD_materials_toon/tests/check.cjs && npm run test:outline && tsx --test tests/*.test.ts",
    "test:outline": "node extensions/MMD_materials_outline/tests/check.cjs",
    "test:browser": "playwright test",
    "check:links": "tsx tools/check-links.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@takahirox/three-mmd": "0.1.2",
    "mmd-parser": "1.1.4",
    "pngjs": "7.0.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "ajv": "8.20.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
