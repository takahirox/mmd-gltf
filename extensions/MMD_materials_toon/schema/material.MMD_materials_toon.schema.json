{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "material.MMD_materials_toon.schema.json",
  "title": "MMD_materials_toon v0.1 draft",
  "description": "Alternate MMD material model on a glTF 2.0 material. Defaults are annotations; consumers apply them when properties are absent.",
  "type": "object",
  "properties": {
    "diffuseFactor": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4,
      "default": [1, 1, 1, 1]
    },
    "ambientFactor": {
      "$ref": "#/$defs/rgb",
      "default": [0, 0, 0]
    },
    "specularFactor": {
      "$ref": "#/$defs/rgb",
      "default": [0, 0, 0]
    },
    "shininessFactor": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "baseTexture": { "$ref": "#/$defs/textureInfo" },
    "sharedToonIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "toonTexture": { "$ref": "#/$defs/generatedTexture" },
    "sphereTexture": { "$ref": "#/$defs/generatedTexture" },
    "sphereMode": {
      "type": "string",
      "enum": ["none", "multiply", "add", "subTexture"],
      "default": "none"
    },
    "extensions": { "$ref": "#/$defs/extensions" },
    "extras": {}
  },
  "additionalProperties": false,
  "allOf": [
    { "not": { "required": ["sharedToonIndex", "toonTexture"] } },
    {
      "if": {
        "required": ["sphereMode"],
        "properties": { "sphereMode": { "enum": ["multiply", "add", "subTexture"] } }
      },
      "then": { "required": ["sphereTexture"] }
    }
  ],
  "$defs": {
    "rgb": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "index": { "type": "integer", "minimum": 0 },
    "extensions": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "textureInfo": {
      "description": "Self-contained glTF textureInfo shape. Extension payloads such as KHR_texture_transform are validated by their own schemas.",
      "type": "object",
      "required": ["index"],
      "properties": {
        "index": { "$ref": "#/$defs/index" },
        "texCoord": { "type": "integer", "minimum": 0, "default": 0 },
        "extensions": { "$ref": "#/$defs/extensions" },
        "extras": {}
      }
    },
    "generatedTexture": {
      "description": "Texture reference with generated UVs; texCoord and texture transforms are not supported here.",
      "type": "object",
      "required": ["index"],
      "properties": { "index": { "$ref": "#/$defs/index" } },
      "additionalProperties": false
    }
  }
}
