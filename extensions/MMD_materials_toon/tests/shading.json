      },
      "lightRGB": [0.5, 1, 0.25],
      "expected": {"litBase": [0.3, 0.4, 0.2], "rgb": [0.075, 0.2, 0.15], "alpha": 0.4}
    },
    {
      "name": "dark-red-map-also-tints-ambient",
      "material": {
        "extensions": {
          "MMD_materials_toon": {
            "diffuseFactor": [0.4, 0.2, 0.6, 0.8],
            "ambientFactor": [0.1, 0.2, 0.05],
