          "required": [
            "weights"
          ]
        },
        "else": {
          "required": [
            "solver",
            "ik",
            "visibility"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "enum": [
              1,
              2
            ]
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "solver"
              ]
            },
            {
              "required": [
                "ik"
              ]
            },
            {
              "required": [
                "visibility"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 4
