{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "gravity",
    "fixedStep",
    "bodies",
    "joints"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "gravity": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "fixedStep": {
      "type": "number",
      "minimum": 0.004166666666666667,
      "maximum": 0.03333333333333333
    },
    "bodies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "name",
          "bone",
          "mode",
          "shape",
          "size",
          "translation",
          "rotation",
          "group",
          "mask",
          "mass",
          "linearDamping",
          "angularDamping",
          "friction",
          "restitution",
          "margin"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "name": {
            "type": "string"
          },
          "bone": {
            "type": "integer",
            "minimum": -1,
            "maximum": 65535
          },
          "mode": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "shape": {
            "enum": [
              "sphere",
              "box",
              "capsule"
            ]
          },
          "size": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "translation": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "rotation": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "group": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "mask": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "mass": {
            "type": "number",
            "minimum": 0
          },
          "linearDamping": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "angularDamping": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "friction": {
            "type": "number",
            "minimum": 0
          },
          "restitution": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "margin": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "joints": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "name",
          "type",
          "bodyA",
          "bodyB",
          "frameA",
          "frameB",
          "linearLower",
          "linearUpper",
          "angularLower",
          "angularUpper",
          "linearSpring",
          "angularSpring"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "name": {
            "type": "string"
          },
          "type": {
            "const": 0
          },
          "bodyA": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "bodyB": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "frameA": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "translation",
              "rotation"
            ],
            "properties": {
              "translation": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "rotation": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "frameB": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "translation",
              "rotation"
            ],
            "properties": {
              "translation": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "rotation": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "linearLower": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "linearUpper": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "angularLower": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "angularUpper": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "linearSpring": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "angularSpring": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
